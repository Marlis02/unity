* text=auto
# Unity YAML: keep LF, merge as text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.playable text eol=lf
*.meta text eol=lf
*.cs text eol=lf diff=csharp
*.shader text eol=lf
# Binaries
*.fbx binary
*.FBX binary
*.obj binary
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.exr binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.zip binary
